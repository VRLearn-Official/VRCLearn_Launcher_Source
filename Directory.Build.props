<Project>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- 产物直接落在 bin\Debug 下，不再套一层 net8.0-windows -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <!-- 检查更新要拿它跟远端版本比。发版时改这里 -->
    <Version>1.22.0</Version>

    <!-- 产物保留产品、公司、说明与版权，版本串不带 git 提交号 -->
    <Product>VRCLearn Launcher</Product>
    <AssemblyTitle>VRCLearn Launcher</AssemblyTitle>
    <Description>VRChat 工程管理器</Description>
    <Company>gamemode1</Company>
    <Copyright>Copyright © 2026 gamemode1</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

</Project>
