<views:DialogWindowBase
    x:Class="VRCLearn.App.Views.ResourceEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:markup="clr-namespace:VRCLearn.App.Markup"
    xmlns:views="clr-namespace:VRCLearn.App.Views"
    Title="{markup:Tr Resources.Edit.Title}"
    Width="720"
    WindowStartupLocation="CenterOwner"
    Style="{StaticResource DialogWindow}">

    <views:DialogChrome Style="{StaticResource DialogChromeStyle}">
        <Grid Margin="24,4,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Style="{StaticResource Caption}"
                Text="{markup:Tr Resources.Edit.Hint}" />

            <ScrollViewer
                Grid.Row="1"
                MaxHeight="560"
                Margin="0,16,0,0"
                Padding="0,0,8,0"
                markup:SmoothScroll.IsEnabled="True"
                VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock
                        Style="{StaticResource SettingLabel}"
                        FontWeight="SemiBold"
                        Text="{markup:Tr Resources.Edit.Cover}" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="112"
                            Height="112"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            CornerRadius="{StaticResource Radius.Control}"
                            ClipToBounds="True">
                            <Grid>
                                <ui:SymbolIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="28"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Symbol="Image24" />
                                <Image Source="{Binding CoverPreview}" Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            Margin="{StaticResource Gap.Inline}"
                            VerticalAlignment="Center">
                            <TextBlock
                                Style="{StaticResource Caption}"
                                Text="{markup:Tr Resources.Edit.CoverHint}" />
                            <ui:Button
                                Margin="0,12,0,0"
                                HorizontalAlignment="Left"
                                Click="OnPickCoverClick"
                                Content="{markup:Tr Resources.Edit.CoverPick}"
                                Style="{StaticResource RowButton}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock
                        Margin="0,20,0,0"
                        Style="{StaticResource SettingLabel}"
                        FontWeight="SemiBold"
                        Text="{markup:Tr Resources.Edit.Name}" />
                    <ui:TextBox
                        Margin="0,8,0,0"
                        Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Margin="0,20,0,0"
                        Style="{StaticResource SettingLabel}"
                        FontWeight="SemiBold"
                        Text="{markup:Tr Resources.Edit.Tags}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{StaticResource Caption}"
                        Text="{markup:Tr Resources.Edit.TagsHint}" />
                    <ui:Card Margin="0,8,0,0" Padding="16">
                        <Grid>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Style="{StaticResource Caption}"
                                Text="{markup:Tr Resources.Edit.TagsEmpty}"
                                Visibility="{Binding HasTags, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                            <ItemsControl
                                ItemsSource="{Binding TagOptions}"
                                Visibility="{Binding HasTags, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            Content="{Binding Name}"
                                            IsChecked="{Binding IsSelected}"
                                            Style="{StaticResource TagToggle}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ui:Card>

                    <TextBlock
                        Margin="0,20,0,0"
                        Style="{StaticResource SettingLabel}"
                        FontWeight="SemiBold"
                        Text="{markup:Tr Resources.Edit.Manual}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{StaticResource Caption}"
                        Text="{markup:Tr Resources.Edit.ManualHint}" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox
                            PlaceholderText="{markup:Tr Resources.Edit.ManualPlaceholder}"
                            Text="{Binding Manual, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button
                            Grid.Column="1"
                            Margin="{StaticResource Gap.Inline}"
                            Click="OnPickManualClick"
                            Content="{markup:Tr Resources.Edit.ManualPick}"
                            Style="{StaticResource RowButton}" />
                    </Grid>
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{StaticResource Caption}"
                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                        Text="{markup:Tr Resources.Edit.ManualMissing}"
                        Visibility="{Binding IsManualMissing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{StaticResource Caption}"
                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                        Text="{markup:Tr Resources.Edit.ManualUnsupported}"
                        Visibility="{Binding IsManualUnsupported, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <TextBlock
                        Margin="0,20,0,0"
                        Style="{StaticResource SettingLabel}"
                        FontWeight="SemiBold"
                        Text="{markup:Tr Resources.Edit.Packages}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{StaticResource Caption}"
                        Text="{markup:Tr Resources.Edit.PackagesHint}" />
                    <ui:Card Margin="0,8,0,0" Padding="8">
                        <StackPanel>
                            <TextBlock
                                Margin="8,8,8,4"
                                Style="{StaticResource Caption}"
                                Text="{markup:Tr Resources.Edit.PackagesEmpty}"
                                Visibility="{Binding HasPackages, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                            <ItemsControl ItemsSource="{Binding PackagePaths}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Padding="8,10"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon
                                                    VerticalAlignment="Top"
                                                    FontSize="{StaticResource IconSize.Inline}"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Symbol="Document24" />
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Margin="0,2,0,0"
                                                        Style="{StaticResource Mono}"
                                                        Text="{Binding Path}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Margin="0,2,0,0"
                                                        Style="{StaticResource Caption}"
                                                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                        Text="{markup:Tr Resources.Edit.PackageMissing}"
                                                        Visibility="{Binding IsMissing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </StackPanel>
                                                <ui:Button
                                                    Grid.Column="2"
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.RemovePackageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="{markup:Tr Resources.Edit.Remove}"
                                                    Style="{StaticResource RowButton}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ui:Button
                                Margin="8"
                                HorizontalAlignment="Left"
                                Click="OnAddPackagesClick"
                                Content="{markup:Tr Resources.Edit.PackagesAdd}"
                                Style="{StaticResource RowButton}" />
                        </StackPanel>
                    </ui:Card>

                    <TextBlock
                        Margin="0,12,0,0"
                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                        Text="{Binding Status}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel
                Grid.Row="2"
                Margin="0,16,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <ui:Button
                    Margin="{StaticResource Gap.Inline}"
                    Appearance="Danger"
                    Click="OnRemoveClick"
                    Content="{markup:Tr Resources.Edit.RemoveResource}"
                    Style="{StaticResource DialogButton}"
                    Visibility="{Binding IsNew, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                <ui:Button
                    Margin="{StaticResource Gap.Inline}"
                    Appearance="Primary"
                    Click="OnSaveClick"
                    Content="{markup:Tr Resources.Edit.Save}"
                    Style="{StaticResource DialogButton}" />
            </StackPanel>
        </Grid>
    </views:DialogChrome>
</views:DialogWindowBase>
