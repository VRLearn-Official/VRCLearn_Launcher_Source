<UserControl
    x:Class="VRCLearn.App.Views.DownloadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:markup="clr-namespace:VRCLearn.App.Markup">

    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel>

            <TextBlock Style="{StaticResource SectionTitle}" Text="{markup:Tr Download.Tools}" />

            <ui:Card Margin="{StaticResource Gap.Field}" Padding="{StaticResource Pad.Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="{markup:Tr Download.CheckHint}" />
                    <WrapPanel Margin="{StaticResource Gap.Row}">
                        <ui:Button
                            Appearance="Primary"
                            Command="{Binding CheckSystemCommand}"
                            Content="{Binding CheckButtonText}"
                            IsEnabled="{Binding IsNotChecking}" />
                    </WrapPanel>
                </StackPanel>
            </ui:Card>

            <TextBlock Style="{StaticResource SectionTitle}" Text="{markup:Tr Download.Official}" />

            <ui:Card Margin="{StaticResource Gap.Field}" Padding="{StaticResource Pad.Card}">
                <WrapPanel>
                    <ui:Button
                        Appearance="Secondary"
                        Command="{Binding DownloadHubCommand}"
                        Content="{markup:Tr Download.HubButton}" />
                    <ui:Button
                        Margin="{StaticResource Gap.Inline}"
                        Appearance="Secondary"
                        Command="{Binding DownloadUnityCommand}"
                        Content="{markup:Tr Download.EditorButton}" />
                    <ui:Button
                        Margin="{StaticResource Gap.Inline}"
                        Appearance="Secondary"
                        Command="{Binding DownloadAndroidCommand}"
                        Content="{markup:Tr Download.Android}" />
                    <ui:Button
                        Margin="{StaticResource Gap.Inline}"
                        Appearance="Secondary"
                        Command="{Binding DownloadIosCommand}"
                        Content="{markup:Tr Download.Ios}" />
                </WrapPanel>
            </ui:Card>

            <ui:Card
                Margin="{StaticResource Gap.Field}"
                Padding="{StaticResource Pad.Card}"
                Visibility="{Binding IsDownloading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource RowTitle}" Text="{Binding CurrentFile}" />
                        <ProgressBar
                            Margin="{StaticResource Gap.Row}"
                            Height="4"
                            Maximum="100"
                            Value="{Binding Progress}" />
                        <TextBlock
                            Margin="{StaticResource Gap.Small}"
                            Style="{StaticResource Caption}"
                            Text="{Binding ProgressText}" />
                    </StackPanel>

                    <ui:Button
                        Grid.Column="1"
                        Margin="24,0,0,0"
                        VerticalAlignment="Center"
                        Appearance="Secondary"
                        Command="{Binding CancelCommand}"
                        Content="{markup:Tr Download.Cancel}" />
                </Grid>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
