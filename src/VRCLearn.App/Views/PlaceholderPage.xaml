<UserControl
    x:Class="VRCLearn.App.Views.PlaceholderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:markup="clr-namespace:VRCLearn.App.Markup">

    <StackPanel
        MaxWidth="420"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">
        <ui:SymbolIcon
            HorizontalAlignment="Center"
            FontSize="{StaticResource IconSize.Empty}"
            Symbol="Hourglass24" />
        <TextBlock
            Margin="{StaticResource Gap.Field}"
            HorizontalAlignment="Center"
            Style="{StaticResource PageTitle}"
            Text="{markup:Tr Placeholder.Title}" />
        <TextBlock
            Margin="{StaticResource Gap.Small}"
            HorizontalAlignment="Center"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{markup:Tr Placeholder.Body}"
            TextAlignment="Center"
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
