<UserControl
    x:Class="VRCLearn.App.Views.TemplatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:markup="clr-namespace:VRCLearn.App.Markup">

    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel>

            <StackPanel Style="{StaticResource Toolbar}">
                <ui:Button
                    Style="{StaticResource ToolbarButton}"
                    Appearance="Primary"
                    Command="{Binding NewTemplateCommand}"
                    Content="{markup:Tr Templates.New}" />
                <ui:Button
                    Style="{StaticResource ToolbarButton}"
                    Appearance="Secondary"
                    Click="OnImportClick"
                    Content="{markup:Tr Templates.Import}" />
            </StackPanel>

            <ui:Card
                Margin="{StaticResource Gap.Field}"
                Padding="0">
                <ui:Card.Style>
                    <Style BasedOn="{StaticResource {x:Type ui:Card}}" TargetType="ui:Card">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:Card.Style>

                <StackPanel>
                    <Border
                        Margin="20,16,20,0"
                        Padding="12"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        CornerRadius="{StaticResource Radius.Control}"
                        Visibility="{Binding HasPendingImport, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding PendingImport}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Style="{StaticResource Caption}"
                                            Text="{Binding Display}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Margin="{StaticResource Gap.Small}" Orientation="Horizontal">
                                <ui:Button
                                    Style="{StaticResource RowButton}"
                                    Margin="0,0,0,0"
                                    Appearance="Primary"
                                    Command="{Binding OverrideImportsCommand}"
                                    Content="{markup:Tr Templates.ImportOverride}" />
                                <ui:Button
                                    Style="{StaticResource RowButton}"
                                    Appearance="Secondary"
                                    Command="{Binding CancelImportsCommand}"
                                    Content="{markup:Tr Templates.ImportCancel}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Templates}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="20,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="{Binding Display}" />
                                        <TextBlock Style="{StaticResource Mono}" Text="{Binding Id}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Style="{StaticResource RowActions}">
                                        <ui:Button
                                            Style="{StaticResource RowButton}"
                                            Margin="0,0,0,0"
                                            Appearance="Primary"
                                            Command="{markup:RowCommand CreateFromCommand}"
                                            CommandParameter="{Binding}"
                                            Content="{markup:Tr Templates.Create}" />
                                        <ui:Button
                                            Style="{StaticResource RowButton}"
                                            Appearance="Secondary"
                                            Command="{markup:RowCommand ToggleFavoriteCommand}"
                                            CommandParameter="{Binding}"
                                            Content="{Binding FavoriteAction}" />
                                        <ui:Button
                                            Style="{StaticResource RowButton}"
                                            Appearance="Secondary"
                                            Command="{markup:RowCommand EditTemplateCommand}"
                                            CommandParameter="{Binding}"
                                            Content="{markup:Tr Templates.Edit}"
                                            Visibility="{Binding IsOwn, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <ui:Button
                                            Style="{StaticResource RowButton}"
                                            Appearance="Secondary"
                                            Command="{markup:RowCommand DuplicateTemplateCommand}"
                                            CommandParameter="{Binding}"
                                            Content="{markup:Tr Templates.Duplicate}" />
                                        <ui:Button
                                            Style="{StaticResource RowButton}"
                                            Appearance="Secondary"
                                            Click="OnExportClick"
                                            Content="{markup:Tr Templates.Export}"
                                            Visibility="{Binding IsOwn, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <ui:Button
                                            Style="{StaticResource RowButton}"
                                            Appearance="Secondary"
                                            Command="{markup:RowCommand RemoveCommand}"
                                            CommandParameter="{Binding}"
                                            Content="{markup:Tr Templates.Remove}"
                                            Visibility="{Binding IsOwn, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>

            <ui:Card
                Margin="{StaticResource Gap.Field}"
                Padding="{StaticResource Pad.Card}"
                Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource RowTitle}" Text="{Binding EditorTitle}" />

                    <HeaderedContentControl
                        Margin="{StaticResource Gap.Field}"
                        Header="{markup:Tr Templates.Name}"
                        Style="{StaticResource FormRow}">
                        <TextBox Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged}" />
                    </HeaderedContentControl>

                    <HeaderedContentControl Header="{markup:Tr Templates.Editor.Base}" Style="{StaticResource FormRow}">
                        <ComboBox
                            DisplayMemberPath="Display"
                            ItemsSource="{Binding Bases}"
                            SelectedItem="{Binding EditorBase}" />
                    </HeaderedContentControl>

                    <HeaderedContentControl Header="{markup:Tr Templates.Editor.UnityVersion}" Style="{StaticResource FormRow}">
                        <StackPanel>
                            <ComboBox
                                IsEditable="True"
                                IsTextSearchEnabled="False"
                                StaysOpenOnEdit="True"
                                markup:SearchBox.IsEnabled="True"
                                ItemsSource="{Binding UnityVersions}"
                                Text="{Binding EditorUnityVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Margin="{StaticResource Gap.Small}"
                                Style="{StaticResource Caption}"
                                Text="{markup:Tr Templates.Editor.UnityVersionHint}" />
                        </StackPanel>
                    </HeaderedContentControl>

                    <TextBlock
                        Margin="{StaticResource Gap.Large}"
                        FontWeight="SemiBold"
                        Text="{markup:Tr Templates.Editor.Dependencies}" />
                    <TextBlock Style="{StaticResource Caption}" Text="{markup:Tr Templates.Editor.DependenciesHint}" />

                    <ItemsControl Margin="{StaticResource Gap.Small}" ItemsSource="{Binding EditorDependencies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="{StaticResource Gap.Small}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox
                                        IsEditable="True"
                                        IsTextSearchEnabled="False"
                                        StaysOpenOnEdit="True"
                                        markup:SearchBox.IsEnabled="True"
                                        ItemsSource="{Binding DataContext.PackageNames, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        Text="{Binding Package, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <ComboBox
                                        Grid.Column="1"
                                        Margin="{StaticResource Gap.Inline}"
                                        IsEditable="True"
                                        IsTextSearchEnabled="False"
                                        StaysOpenOnEdit="True"
                                        markup:SearchBox.IsEnabled="True"
                                        ItemsSource="{Binding Versions}"
                                        Text="{Binding Range, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <ui:Button
                                        Grid.Column="2"
                                        Style="{StaticResource RowButton}"
                                        Appearance="Secondary"
                                        Command="{markup:RowCommand RemoveDependencyCommand}"
                                        CommandParameter="{Binding}"
                                        Content="{markup:Tr Templates.Remove}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ui:Button
                        Margin="{StaticResource Gap.Small}"
                        HorizontalAlignment="Left"
                        Appearance="Secondary"
                        Command="{Binding AddDependencyCommand}"
                        Content="{markup:Tr Templates.Editor.AddDependency}" />

                    <TextBlock
                        Margin="{StaticResource Gap.Large}"
                        FontWeight="SemiBold"
                        Text="{markup:Tr Templates.Editor.UnityPackages}" />
                    <TextBlock Style="{StaticResource Caption}" Text="{markup:Tr Templates.Editor.UnityPackagesHint}" />

                    <ItemsControl Margin="{StaticResource Gap.Small}" ItemsSource="{Binding EditorUnityPackages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="{StaticResource Gap.Small}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource Mono}"
                                        Text="{Binding}"
                                        TextWrapping="Wrap" />
                                    <ui:Button
                                        Grid.Column="1"
                                        Style="{StaticResource RowButton}"
                                        Appearance="Secondary"
                                        Command="{markup:RowCommand RemoveUnityPackageCommand}"
                                        CommandParameter="{Binding}"
                                        Content="{markup:Tr Templates.Remove}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ui:Button
                        Margin="{StaticResource Gap.Small}"
                        HorizontalAlignment="Left"
                        Appearance="Secondary"
                        Click="OnAddUnityPackageClick"
                        Content="{markup:Tr Templates.Editor.AddUnityPackage}" />

                    <StackPanel Margin="{StaticResource Gap.Large}" Orientation="Horizontal">
                        <ui:Button
                            MinWidth="88"
                            Appearance="Primary"
                            Command="{Binding SaveTemplateCommand}"
                            Content="{markup:Tr Templates.Editor.Save}" />
                        <ui:Button
                            MinWidth="88"
                            Margin="{StaticResource Gap.Inline}"
                            Appearance="Secondary"
                            Command="{Binding CancelEditCommand}"
                            Content="{markup:Tr Templates.Editor.Cancel}" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
