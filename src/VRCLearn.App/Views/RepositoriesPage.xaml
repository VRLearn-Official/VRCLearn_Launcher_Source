<UserControl
    x:Class="VRCLearn.App.Views.RepositoriesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:markup="clr-namespace:VRCLearn.App.Markup">

    <UserControl.Resources>
        <DataTemplate x:Key="RecommendedGroupTemplate">
            <ui:Card Margin="0,0,0,8" Padding="{StaticResource Pad.CardRow}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{Binding Name}" />
                            <TextBlock
                                Margin="{StaticResource Gap.Tight}"
                                Style="{StaticResource Caption}"
                                Text="{Binding Description}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <ui:Button
                                Appearance="Secondary"
                                Command="{Binding VisitCommand}"
                                Content="{markup:Tr Repositories.Visit}" />
                            <ui:Button
                                Margin="{StaticResource Gap.Inline}"
                                Appearance="Primary"
                                Command="{markup:RowCommand AddRecommendedGroupCommand, AncestorType={x:Type UserControl}}"
                                CommandParameter="{Binding}"
                                Content="{markup:Tr Repositories.AddAll}"
                                Visibility="{Binding HasMissing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </Grid>

                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Repositories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="{Binding DisplayName}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CaptionDim}"
                                        Text="{Binding Url}" />

                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource Caption}"
                                        Text="{markup:Tr Repositories.AlreadyAdded}"
                                        Visibility="{Binding IsAdded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ui:Button
                                        Grid.Column="2"
                                        Style="{StaticResource RowButton}"
                                        Margin="0,0,0,0"
                                        Appearance="Secondary"
                                        Command="{markup:RowCommand AddRecommendedCommand, AncestorType={x:Type UserControl}}"
                                        CommandParameter="{Binding}"
                                        Content="{markup:Tr Repositories.Add}"
                                        Visibility="{Binding IsNotAdded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer
        Style="{StaticResource PageScroll}"
        AllowDrop="True"
        DragOver="OnPageDragOver">
        <StackPanel>

            <DockPanel Margin="{StaticResource Gap.Field}">
                <ui:Button
                    DockPanel.Dock="Right"
                    Margin="{StaticResource Gap.Inline}"
                    Appearance="Primary"
                    Command="{Binding AddCommand}"
                    Content="{markup:Tr Repositories.Add}" />
                <ui:TextBox
                    PlaceholderText="{markup:Tr Repositories.UrlPlaceholder}"
                    Text="{Binding NewRepositoryUrl, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>

            <StackPanel Style="{StaticResource Toolbar}">
                <ui:Button
                    Style="{StaticResource ToolbarButton}"
                    Appearance="Secondary"
                    Command="{Binding ImportCommand}"
                    Content="{markup:Tr Repositories.ImportTitle}" />
                <ui:Button
                    Style="{StaticResource ToolbarButton}"
                    Appearance="Secondary"
                    Click="OnExportClick"
                    Content="{markup:Tr Repositories.Export}" />
                <ui:Button
                    Style="{StaticResource ToolbarButton}"
                    Appearance="Secondary"
                    Command="{Binding RefreshCommand}"
                    Content="{markup:Tr Repositories.Refresh}" />
                <ui:ProgressRing Margin="4,0,0,0" Style="{StaticResource BusyRing}" />
            </StackPanel>

            <TextBlock Style="{StaticResource SectionTitle}" Text="{markup:Tr Repositories.List}" />

            <ui:Card Margin="{StaticResource Gap.Row}" Padding="0">
                <StackPanel>
                    <TextBlock
                        Margin="20,16"
                        Style="{StaticResource Caption}"
                        Text="{markup:Tr Repositories.Empty}"
                        Visibility="{Binding HasRepositories, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

                    <ItemsControl ItemsSource="{Binding Repositories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel
                                    AllowDrop="True"
                                    DragOver="OnRowDragOver"
                                    Drop="OnRowDrop"
                                    MouseLeftButtonUp="OnRowMouseUp"
                                    MouseMove="OnRowMouseMove">
                                    <Border
                                        x:Name="SlotAbove"
                                        Height="2"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                        Opacity="0" />

                                    <Grid
                                        x:Name="RowContent"
                                        Margin="20,12"
                                        Background="Transparent">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                        <Setter Property="Opacity" Value="0.45" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                                        <Setter Property="Opacity" Value="0.4" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Grid.Column="0"
                                            Margin="0,0,12,0"
                                            Padding="6,2"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            Cursor="SizeAll"
                                            MouseLeftButtonDown="OnHandleMouseDown">
                                            <TextBlock
                                                FontSize="16"
                                                IsHitTestVisible="False"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="≡" />
                                        </Border>

                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="{Binding Title}" />
                                                <Border
                                                    Margin="{StaticResource Gap.Inline}"
                                                    Padding="6,1"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                    CornerRadius="{StaticResource Radius.Control}"
                                                    Visibility="{Binding IsHidden, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock
                                                        FontSize="{StaticResource FontSize.Caption}"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                        Text="{markup:Tr Repositories.Hidden}" />
                                                </Border>
                                            </StackPanel>

                                            <TextBlock
                                                Margin="{StaticResource Gap.Tight}"
                                                Style="{StaticResource Caption}"
                                                Text="{Binding Details}" />
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Summary}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Style="{StaticResource RowActions}">
                                            <ui:Button
                                                Style="{StaticResource RowButton}"
                                                Margin="0,0,0,0"
                                                Appearance="Secondary"
                                                Command="{markup:RowCommand ToggleHiddenCommand}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding HideAction}" />
                                            <ui:Button
                                                Style="{StaticResource RowButton}"
                                                Appearance="Secondary"
                                                Command="{markup:RowCommand RemoveCommand}"
                                                CommandParameter="{Binding}"
                                                Content="{markup:Tr Repositories.Remove}" />
                                        </StackPanel>
                                    </Grid>

                                    <Border
                                        x:Name="SlotBelow"
                                        Height="2"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                        Opacity="0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>

            <TextBlock Style="{StaticResource SectionTitle}" Text="{markup:Tr Repositories.Recommended}" />

            <ItemsControl
                Margin="{StaticResource Gap.Row}"
                ItemTemplate="{StaticResource RecommendedGroupTemplate}"
                ItemsSource="{Binding Official}" />

            <StackPanel
                x:Name="MirrorSection"
                Visibility="{Binding ShowMirrors, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Style="{StaticResource SectionTitle}" Text="{markup:Tr Repositories.Mirrors}" />
                <TextBlock
                    Margin="{StaticResource Gap.Small}"
                    Style="{StaticResource Caption}"
                    Text="{markup:Tr Repositories.MirrorsHint}" />

                <ItemsControl
                    Margin="{StaticResource Gap.Row}"
                    ItemTemplate="{StaticResource RecommendedGroupTemplate}"
                    ItemsSource="{Binding Mirrors}" />
            </StackPanel>

            <TextBlock Style="{StaticResource SectionTitle}" Text="{markup:Tr Packages.User.Title}" />

            <ui:Card Margin="{StaticResource Gap.Row}" Padding="{StaticResource Pad.CardRow}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Caption}" Text="{markup:Tr Packages.User.Hint}" />
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <CheckBox
                                VerticalAlignment="Center"
                                Content="{markup:Tr Packages.User.Hide}"
                                IsChecked="{Binding UserPackages.HideUserPackages}" />
                            <ui:Button
                                Margin="12,0,0,0"
                                Appearance="Secondary"
                                Click="OnAddUserPackageClick"
                                Content="{markup:Tr Packages.User.Add}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock
                        Margin="{StaticResource Gap.Row}"
                        Style="{StaticResource Caption}"
                        Text="{markup:Tr Packages.User.None}"
                        Visibility="{Binding UserPackages.HasNoFolders, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <ItemsControl Margin="{StaticResource Gap.Small}" ItemsSource="{Binding UserPackages.Folders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon
                                        VerticalAlignment="Center"
                                        FontSize="{StaticResource IconSize.Inline}"
                                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                        Symbol="Warning24"
                                        Visibility="{Binding IsUnreadable, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <StackPanel Grid.Column="1" Margin="{StaticResource Gap.Inline}">
                                        <TextBlock FontSize="{StaticResource FontSize.Caption}" Text="{Binding DisplayName}" TextWrapping="Wrap" />
                                        <TextBlock
                                            FontFamily="Consolas"
                                            FontSize="{StaticResource FontSize.Caption}"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Path}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <ui:Button
                                        Grid.Column="2"
                                        Style="{StaticResource RowButton}"
                                        Appearance="Secondary"
                                        Command="{markup:RowCommand UserPackages.RemoveCommand}"
                                        CommandParameter="{Binding}"
                                        Content="{markup:Tr Repositories.Remove}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
