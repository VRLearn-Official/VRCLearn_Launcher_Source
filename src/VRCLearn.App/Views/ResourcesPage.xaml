<UserControl
    x:Class="VRCLearn.App.Views.ResourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:markup="clr-namespace:VRCLearn.App.Markup"
    xmlns:views="clr-namespace:VRCLearn.App.Views">

    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel>
            <Grid Margin="{StaticResource Gap.Field}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:TextBox
                    ClearButtonEnabled="True"
                    PlaceholderText="{markup:Tr Resources.SearchPlaceholder}"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                <ui:Button
                    Grid.Column="1"
                    Margin="{StaticResource Gap.Inline}"
                    Appearance="Secondary"
                    Command="{Binding FilterCommand}"
                    Content="{markup:Tr Resources.Filter}" />

                <ui:Button
                    Grid.Column="2"
                    Margin="{StaticResource Gap.Inline}"
                    Appearance="Secondary"
                    Command="{Binding ManageTagsCommand}"
                    Content="{markup:Tr Resources.Manage}" />

                <ui:Button
                    Grid.Column="3"
                    Margin="{StaticResource Gap.Inline}"
                    Appearance="Secondary"
                    Command="{Binding ImportSelectedCommand}"
                    Content="{markup:Tr Resources.ImportSelected}" />

                <ui:Button
                    Grid.Column="4"
                    Margin="{StaticResource Gap.Inline}"
                    Appearance="Primary"
                    Command="{Binding NewResourceCommand}"
                    Content="{markup:Tr Resources.New}" />

                <ui:ProgressRing
                    Grid.Column="5"
                    Margin="{StaticResource Gap.Inline}"
                    Style="{StaticResource BusyRing}" />
            </Grid>

            <TextBlock
                Margin="{StaticResource Gap.Field}"
                Style="{StaticResource Caption}"
                Text="{Binding EmptyText}"
                Visibility="{Binding HasResources, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

            <ItemsControl Margin="{StaticResource Gap.Field}" ItemsSource="{Binding Resources}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <views:ResourceCard />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
