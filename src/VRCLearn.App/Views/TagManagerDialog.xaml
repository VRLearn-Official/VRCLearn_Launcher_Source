<views:DialogWindowBase
    x:Class="VRCLearn.App.Views.TagManagerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:markup="clr-namespace:VRCLearn.App.Markup"
    xmlns:views="clr-namespace:VRCLearn.App.Views"
    Title="{markup:Tr Resources.Manage.Title}"
    Width="480"
    WindowStartupLocation="CenterOwner"
    Style="{StaticResource DialogWindow}">

    <views:DialogChrome Style="{StaticResource DialogChromeStyle}">
        <Grid Margin="24,4,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Style="{StaticResource Caption}"
                Text="{markup:Tr Resources.Manage.Hint}" />

            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox
                    x:Name="NewTagBox"
                    PlaceholderText="{markup:Tr Resources.Manage.AddPlaceholder}"
                    Text="{Binding NewTag, UpdateSourceTrigger=PropertyChanged}"
                    KeyDown="OnNewTagKeyDown" />
                <ui:Button
                    Grid.Column="1"
                    MinWidth="88"
                    Margin="{StaticResource Gap.Inline}"
                    Appearance="Secondary"
                    Command="{Binding AddTagCommand}"
                    Content="{markup:Tr Resources.Manage.Add}" />
            </Grid>

            <ui:Card
                Grid.Row="2"
                MinHeight="160"
                MaxHeight="280"
                Margin="0,16,0,0"
                Padding="16">
                <Grid>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource Caption}"
                        Text="{markup:Tr Resources.Manage.Empty}"
                        Visibility="{Binding HasTags, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                    <ScrollViewer
                        VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding HasTags, Converter={StaticResource BooleanToVisibilityConverter}}"
                        markup:SmoothScroll.IsEnabled="True">
                        <views:TagChips
                            IsRemovable="True"
                            ItemsSource="{Binding Tags}"
                            RemoveCommand="{Binding RemoveTagCommand}" />
                    </ScrollViewer>
                </Grid>
            </ui:Card>

            <TextBlock
                Grid.Row="3"
                Margin="0,12,0,0"
                Style="{StaticResource Caption}"
                Text="{Binding Status}" />

            <ui:Button
                Grid.Row="4"
                Margin="0,16,0,0"
                HorizontalAlignment="Left"
                Appearance="Secondary"
                Command="{Binding CleanupCommand}"
                Content="{markup:Tr Resources.Manage.Cleanup}"
                Style="{StaticResource DialogButton}" />
        </Grid>
    </views:DialogChrome>
</views:DialogWindowBase>
