<UserControl
    x:Class="VRCLearn.App.Views.BackupsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:markup="clr-namespace:VRCLearn.App.Markup">

    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel>

            <Grid Margin="{StaticResource Gap.Field}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:TextBox
                    PlaceholderText="{markup:Tr Backups.SearchPlaceholder}"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                <ComboBox
                    Grid.Column="1"
                    MinWidth="150"
                    Margin="{StaticResource Gap.Inline}"
                    DisplayMemberPath="Display"
                    ItemsSource="{Binding SortOptions}"
                    SelectedValue="{Binding SelectedSort}"
                    SelectedValuePath="Value" />

                <ComboBox
                    Grid.Column="2"
                    MinWidth="100"
                    Margin="{StaticResource Gap.Inline}"
                    DisplayMemberPath="Display"
                    ItemsSource="{Binding FilterOptions}"
                    SelectedValue="{Binding SelectedFilter}"
                    SelectedValuePath="Value" />

                <ui:Button
                    Grid.Column="3"
                    Margin="{StaticResource Gap.Inline}"
                    Appearance="Secondary"
                    Command="{Binding OpenDirectoryCommand}"
                    Content="{markup:Tr Backups.OpenDirectory}" />

                <ui:Button
                    Grid.Column="4"
                    Margin="{StaticResource Gap.Inline}"
                    Appearance="Secondary"
                    Command="{Binding ImportCommand}"
                    Content="{markup:Tr Backups.Import}" />

                <ui:Button
                    Grid.Column="5"
                    Margin="{StaticResource Gap.Inline}"
                    Appearance="Secondary"
                    Command="{Binding ConfigureAutoBackupCommand}"
                    Content="{markup:Tr Backups.AutoBackup}"
                    Icon="{ui:SymbolIcon Settings24}"
                    ToolTip="{markup:Tr Backups.AutoBackupHint}"
                    Visibility="{markup:ExperimentalVisibility}" />

                <ui:ProgressRing
                    Grid.Column="6"
                    Margin="{StaticResource Gap.Inline}"
                    Style="{StaticResource BusyRing}" />
            </Grid>

            <TextBlock
                Margin="{StaticResource Gap.Field}"
                Style="{StaticResource Caption}"
                Text="{Binding EmptyText}"
                Visibility="{Binding HasBackups, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

            <ItemsControl Margin="{StaticResource Gap.Field}" ItemsSource="{Binding Backups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Opacity="{Binding RowOpacity}" Style="{StaticResource RowCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{Binding ProjectName}" />
                                    <StackPanel Margin="{StaticResource Gap.Tight}" Orientation="Horizontal">
                                        <TextBlock
                                            Style="{StaticResource Caption}"
                                            Text="{Binding Display}"
                                            ToolTip="{Binding FileName}" />
                                        <TextBlock
                                            Margin="{StaticResource Gap.Inline}"
                                            Style="{StaticResource Caption}"
                                            Text="{Binding SizeText}" />
                                    </StackPanel>
                                    <TextBlock
                                        Margin="{StaticResource Gap.Tight}"
                                        Style="{StaticResource CaptionDim}"
                                        Text="{Binding Note}"
                                        ToolTip="{Binding Note}"
                                        Visibility="{Binding HasNote, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Style="{StaticResource RowActions}">
                                    <TextBlock
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource Caption}"
                                        Text="{markup:Tr Backups.FileMoved}"
                                        Visibility="{Binding IsMissing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ui:Button
                                        Margin="0,0,0,0"
                                        Appearance="Primary"
                                        Command="{markup:RowCommand RestoreCommand}"
                                        CommandParameter="{Binding}"
                                        Content="{markup:Tr Backups.Restore}"
                                        Style="{StaticResource RowButton}"
                                        Visibility="{Binding IsAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ui:Button
                                        Appearance="Secondary"
                                        Command="{markup:RowCommand DeleteCommand}"
                                        CommandParameter="{Binding}"
                                        Content="{markup:Tr Backups.Delete}"
                                        Style="{StaticResource RowButton}" />
                                    <ui:Button
                                        Appearance="Secondary"
                                        Command="{markup:RowCommand LockCommand}"
                                        CommandParameter="{Binding}"
                                        Content="{markup:Tr Backups.Lock}"
                                        Style="{StaticResource RowButton}"
                                        Visibility="{Binding CanLock, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ui:Button
                                        Appearance="Secondary"
                                        Command="{markup:RowCommand EditNoteCommand}"
                                        CommandParameter="{Binding}"
                                        Content="{markup:Tr Backups.Note}"
                                        Style="{StaticResource RowButton}"
                                        Visibility="{Binding CanEditNote, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
