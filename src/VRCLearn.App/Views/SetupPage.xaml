<UserControl
    x:Class="VRCLearn.App.Views.SetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:markup="clr-namespace:VRCLearn.App.Markup">

    <UserControl.Resources>
        <markup:StepVisibilityConverter x:Key="StepVisibility" />

        <Style x:Key="StepHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSize.Step}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="StepCaption" TargetType="TextBlock">
            <Setter Property="Margin" Value="{StaticResource Gap.Row}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            x:Name="Scroller"
            Grid.Row="0"
            VerticalContentAlignment="Top"
            VerticalScrollBarVisibility="Auto"
            markup:SmoothScroll.IsEnabled="True">
            <StackPanel
                Width="760"
                HorizontalAlignment="Center"
                VerticalAlignment="Top">

                <TextBlock Style="{StaticResource StepCaption}" Text="{Binding StepCaption}" />

                <ui:Card Margin="{StaticResource Gap.Large}" Padding="32">
                    <Grid x:Name="Steps">

                        <StackPanel Visibility="{Binding Step, Converter={StaticResource StepVisibility}, ConverterParameter=0}">
                            <TextBlock Style="{StaticResource StepHeading}" Text="{markup:Tr Setup.Appearance}" />
                            <TextBlock
                                Style="{StaticResource StepCaption}"
                                Text="{markup:Tr Setup.AppearanceHint}" />

                            <HeaderedContentControl
                                Margin="{StaticResource Gap.Large}"
                                Header="{markup:Tr Settings.Language}"
                                Style="{StaticResource FieldRow}">
                                <ComboBox
                                    MinWidth="260"
                                    DisplayMemberPath="Display"
                                    ItemsSource="{Binding Languages}"
                                    SelectedValue="{Binding SelectedLanguage}"
                                    SelectedValuePath="Value" />
                            </HeaderedContentControl>

                            <HeaderedContentControl
                                Margin="{StaticResource Gap.Large}"
                                Header="{markup:Tr Settings.Theme}"
                                Style="{StaticResource FieldRow}">
                                <ComboBox
                                    MinWidth="260"
                                    DisplayMemberPath="Display"
                                    ItemsSource="{Binding Themes}"
                                    SelectedValue="{Binding SelectedTheme}"
                                    SelectedValuePath="Value" />
                            </HeaderedContentControl>
                        </StackPanel>

                        <StackPanel Visibility="{Binding Step, Converter={StaticResource StepVisibility}, ConverterParameter=1}">
                            <TextBlock Style="{StaticResource StepHeading}" Text="{markup:Tr Settings.UnityHub}" />
                            <TextBlock
                                Style="{StaticResource StepCaption}"
                                Text="{markup:Tr Setup.UnityHint}" />

                            <DockPanel Margin="{StaticResource Gap.Large}" Style="{StaticResource BrowseRow}">
                                <ui:Button
                                    DockPanel.Dock="Right"
                                    Click="OnBrowseUnityHubClick"
                                    Content="{markup:Tr Templates.Browse}"
                                    Style="{StaticResource BrowseButton}" />
                                <ui:TextBox
                                    Style="{StaticResource PathTextBox}"
                                    Text="{Binding UnityHubPath, Mode=OneWay}" />
                            </DockPanel>
                        </StackPanel>

                        <StackPanel Visibility="{Binding Step, Converter={StaticResource StepVisibility}, ConverterParameter=2}">
                            <TextBlock Style="{StaticResource StepHeading}" Text="{markup:Tr Setup.UnityVersions}" />
                            <TextBlock
                                Style="{StaticResource StepCaption}"
                                Text="{markup:Tr Setup.UnityVersionsHint}" />

                            <StackPanel Visibility="{Binding HasNoEditors, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock
                                    Margin="{StaticResource Gap.Large}"
                                    FontSize="{StaticResource FontSize.Subtitle}"
                                    Text="{markup:Tr Setup.UnityVersionsEmpty}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Margin="{StaticResource Gap.Small}"
                                    Style="{StaticResource StepCaption}"
                                    Text="{markup:Tr Setup.UnityVersionsEmptyHint}" />
                            </StackPanel>

                            <ItemsControl Margin="{StaticResource Gap.Large}" ItemsSource="{Binding InstalledEditors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon
                                                Grid.Column="0"
                                                Margin="0,0,12,0"
                                                VerticalAlignment="Center"
                                                FontSize="{StaticResource IconSize.Inline}"
                                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                Symbol="Checkmark24" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="{Binding Version}" />
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    FontFamily="Consolas"
                                                    FontSize="{StaticResource FontSize.Caption}"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding Path}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <WrapPanel Margin="{StaticResource Gap.Large}" HorizontalAlignment="Left">
                                <ui:Button
                                    Appearance="Secondary"
                                    Command="{Binding DetectEditorsCommand}"
                                    Content="{markup:Tr Setup.UnityVersionsRefresh}" />
                                <ui:Button
                                    Margin="{StaticResource Gap.Inline}"
                                    Appearance="Secondary"
                                    Click="OnAddUnityEditorClick"
                                    Content="{markup:Tr Setup.UnityVersionsAdd}" />
                            </WrapPanel>

                            <Separator Margin="{StaticResource Gap.Large}" />

                            <TextBlock
                                Margin="{StaticResource Gap.Large}"
                                Style="{StaticResource RowTitle}"
                                Text="{markup:Tr Settings.ProjectPath}" />
                            <TextBlock
                                Margin="{StaticResource Gap.Small}"
                                FontSize="{StaticResource FontSize.Body}"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{markup:Tr Settings.ProjectPathHint}"
                                TextWrapping="Wrap" />

                            <DockPanel Margin="{StaticResource Gap.Large}" Style="{StaticResource BrowseRow}">
                                <ui:Button
                                    DockPanel.Dock="Right"
                                    Click="OnBrowseProjectDirectoryClick"
                                    Content="{markup:Tr Templates.Browse}"
                                    Style="{StaticResource BrowseButton}" />
                                <ui:TextBox
                                    Style="{StaticResource PathTextBox}"
                                    Text="{Binding ProjectDirectory, Mode=OneWay}" />
                            </DockPanel>
                        </StackPanel>

                        <StackPanel Visibility="{Binding Step, Converter={StaticResource StepVisibility}, ConverterParameter=3}">
                            <TextBlock Style="{StaticResource StepHeading}" Text="{markup:Tr Setup.Storage}" />
                            <TextBlock
                                Style="{StaticResource StepCaption}"
                                Text="{markup:Tr Settings.BackupDirectoryHint}" />

                            <DockPanel Margin="{StaticResource Gap.Large}" Style="{StaticResource BrowseRow}">
                                <ui:Button
                                    DockPanel.Dock="Right"
                                    Click="OnBrowseBackupDirectoryClick"
                                    Content="{markup:Tr Templates.Browse}"
                                    Style="{StaticResource BrowseButton}" />
                                <ui:TextBox
                                    Style="{StaticResource PathTextBox}"
                                    Text="{Binding BackupDirectory, Mode=OneWay}" />
                            </DockPanel>

                            <TextBlock
                                Margin="{StaticResource Gap.Large}"
                                Style="{StaticResource RowTitle}"
                                Text="{markup:Tr Settings.CachePath}" />

                            <DockPanel Margin="{StaticResource Gap.Large}" Style="{StaticResource BrowseRow}">
                                <ui:Button
                                    DockPanel.Dock="Right"
                                    Click="OnRestoreCacheDirectoryClick"
                                    Content="{markup:Tr Settings.CachePath.Reset}"
                                    IsEnabled="{Binding Cache.HasCustom}"
                                    Style="{StaticResource BrowseButton}" />
                                <ui:Button
                                    DockPanel.Dock="Right"
                                    Click="OnBrowseCacheDirectoryClick"
                                    Content="{markup:Tr Templates.Browse}"
                                    Style="{StaticResource BrowseButton}" />
                                <ui:TextBox
                                    Style="{StaticResource PathTextBox}"
                                    Text="{Binding Cache.Current, Mode=OneWay}" />
                            </DockPanel>

                            <TextBlock
                                Margin="{StaticResource Gap.Small}"
                                FontSize="{StaticResource FontSize.Body}"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{markup:Tr Settings.CachePathHint}"
                                TextWrapping="Wrap" />

                            <StackPanel
                                Margin="{StaticResource Gap.Row}"
                                HorizontalAlignment="Left"
                                Orientation="Horizontal">
                                <ui:ProgressRing
                                    Style="{StaticResource BusyRing}"
                                    Visibility="{Binding Cache.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>

                            <HeaderedContentControl Margin="{StaticResource Gap.Large}" Style="{StaticResource FieldRow}">
                                <HeaderedContentControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{markup:Tr Settings.UseForVccProtocol}" />
                                        <TextBlock
                                            Margin="{StaticResource Gap.Small}"
                                            FontSize="{StaticResource FontSize.Body}"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{markup:Tr Settings.UseForVccProtocolHint}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </HeaderedContentControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding UseForVccProtocol}" />
                            </HeaderedContentControl>
                        </StackPanel>

                        <StackPanel Visibility="{Binding Step, Converter={StaticResource StepVisibility}, ConverterParameter=4}">
                            <TextBlock Style="{StaticResource StepHeading}" Text="{markup:Tr Setup.Repositories}" />
                            <TextBlock
                                Style="{StaticResource StepCaption}"
                                Text="{markup:Tr Setup.RepositoriesHint}" />

                            <ItemsControl Margin="{StaticResource Gap.Large}" ItemsSource="{Binding RepositoryGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="{Binding Name}" />
                                                <TextBlock
                                                    Margin="{StaticResource Gap.Tight}"
                                                    Style="{StaticResource Caption}"
                                                    Text="{Binding Description}" />
                                            </StackPanel>

                                            <StackPanel
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                                <TextBlock
                                                    Margin="{StaticResource Gap.Inline}"
                                                    VerticalAlignment="Center"
                                                    Text="{markup:Tr Repositories.AlreadyAdded}">
                                                    <TextBlock.Style>
                                                        <Style BasedOn="{StaticResource Caption}" TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasMissing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <ui:Button
                                                    Margin="{StaticResource Gap.Inline}"
                                                    Appearance="Secondary"
                                                    Command="{Binding VisitCommand}"
                                                    Content="{markup:Tr Repositories.Visit}" />

                                                <ui:Button
                                                    Margin="{StaticResource Gap.Inline}"
                                                    Appearance="Primary"
                                                    Command="{markup:RowCommand AddRepositoryGroupCommand}"
                                                    CommandParameter="{Binding}"
                                                    Content="{markup:Tr Repositories.AddAll}"
                                                    Visibility="{Binding HasMissing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ui:ProgressRing
                                Margin="{StaticResource Gap.Row}"
                                HorizontalAlignment="Left"
                                Style="{StaticResource BusyRing}" />

                        </StackPanel>


                        <StackPanel Visibility="{Binding Step, Converter={StaticResource StepVisibility}, ConverterParameter=5}">
                            <TextBlock Style="{StaticResource StepHeading}" Text="{markup:Tr Setup.EnvironmentCheck}" />
                            <TextBlock
                                Style="{StaticResource StepCaption}"
                                Text="{markup:Tr Setup.EnvironmentCheckHint}" />

                            <ui:Button
                                Margin="{StaticResource Gap.Large}"
                                HorizontalAlignment="Left"
                                Appearance="Primary"
                                Command="{Binding RunCheckCommand}"
                                Content="{markup:Tr Setup.EnvironmentCheckRun}"
                                Visibility="{Binding HasChecked, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

                            <ui:ProgressRing
                                Margin="{StaticResource Gap.Large}"
                                HorizontalAlignment="Left"
                                Style="{StaticResource BusyRing}"
                                Visibility="{Binding IsChecking, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <ui:Card
                                Margin="{StaticResource Gap.Field}"
                                Padding="{StaticResource Pad.Card}"
                                Visibility="{Binding HasChecked, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl ItemTemplate="{StaticResource CheckReportRow}" ItemsSource="{Binding CheckResults}" />
                            </ui:Card>
                        </StackPanel>
                    </Grid>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <Grid
            Grid.Row="1"
            Width="760"
            Margin="{StaticResource Gap.Large}"
            HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:Button
                Grid.Column="0"
                MinWidth="128"
                HorizontalAlignment="Left"
                Appearance="Secondary"
                Command="{Binding BackCommand}"
                Content="{markup:Tr Setup.Back}"
                IsEnabled="{Binding CanGoBack}" />

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <ui:Button
                    MinWidth="128"
                    Appearance="Secondary"
                    Command="{Binding CancelCommand}"
                    Content="{markup:Tr Dialog.Cancel}"
                    Visibility="{Binding IsRerun, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ui:Button
                    MinWidth="128"
                    Margin="12,0,0,0"
                    Appearance="Primary"
                    Command="{Binding NextCommand}"
                    Content="{markup:Tr Setup.Next}"
                    Visibility="{Binding IsNotLastStep, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ui:Button
                    MinWidth="128"
                    Margin="12,0,0,0"
                    Appearance="Primary"
                    Command="{Binding FinishCommand}"
                    Content="{markup:Tr Setup.Finish}"
                    IsEnabled="{Binding CanFinish}"
                    Visibility="{Binding IsLastStep, Converter={StaticResource BooleanToVisibilityConverter}}" />

            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
