<views:DialogWindowBase
    x:Class="VRCLearn.App.Views.CheckReportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:VRCLearn.App.Views"
    Width="520"
    WindowStartupLocation="CenterOwner"
    Style="{StaticResource DialogWindow}">

    <views:DialogChrome Style="{StaticResource DialogChromeStyle}">

        <StackPanel Margin="20,0,20,16">
            <ItemsControl x:Name="Rows" ItemTemplate="{StaticResource CheckReportRow}" />

            <StackPanel Style="{StaticResource DialogRow}">
                <ui:Button
                    x:Name="CloseButton"
                    Appearance="Primary"
                    Click="OnConfirmClick"
                    Style="{StaticResource DialogButton}" />
            </StackPanel>
        </StackPanel>
    </views:DialogChrome>
</views:DialogWindowBase>
