<views:DialogWindowBase
    x:Class="VRCLearn.App.Views.LicensesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:VRCLearn.App.Views"
    Width="920"
    Height="620"
    MinWidth="760"
    MinHeight="480"
    ResizeMode="CanResize"
    SizeToContent="Manual"
    WindowStartupLocation="CenterOwner"
    Style="{StaticResource DialogWindow}">

    <views:DialogChrome Style="{StaticResource DialogChromeStyle}">

        <Grid Margin="20,0,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ListBox
                    x:Name="Sections"
                    Grid.Column="0"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource NavItemStyle}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectionChanged="OnSectionChanged" />

                <Border
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    Background="{DynamicResource SolidBackgroundFillColorBaseAltBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Control}">
                    <TextBox
                        x:Name="BodyText"
                        Padding="12,10"
                        AcceptsReturn="True"
                        FontSize="{StaticResource FontSize.Caption}"
                        Style="{StaticResource InfoTextBox}"
                        TextWrapping="Wrap"
                        VerticalContentAlignment="Top"
                        VerticalScrollBarVisibility="Auto" />
                </Border>
            </Grid>

            <StackPanel Grid.Row="1" Style="{StaticResource DialogRow}">
                <ui:Button
                    x:Name="CloseButton"
                    Appearance="Primary"
                    Click="OnConfirmClick"
                    Style="{StaticResource DialogButton}" />
            </StackPanel>
        </Grid>
    </views:DialogChrome>
</views:DialogWindowBase>
