<UserControl
    x:Class="VRCLearn.App.Views.UnityActionButton"
    x:Name="Root"
    Focusable="False"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:markup="clr-namespace:VRCLearn.App.Markup">

    <Grid>
        <ui:Button
            Appearance="Primary"
            Command="{Binding LaunchCommand, ElementName=Root}"
            CommandParameter="{Binding CommandParameter, ElementName=Root}"
            Content="{markup:Tr Projects.LaunchUnity}"
            Focusable="{Binding ButtonFocusable, ElementName=Root}"
            Icon="{ui:SymbolIcon Play24}"
            Style="{Binding ButtonStyle, ElementName=Root}"
            Visibility="{Binding IsUnityRunning, ElementName=Root, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

        <ui:Button
            Appearance="Primary"
            Command="{Binding BringToFrontCommand, ElementName=Root}"
            CommandParameter="{Binding CommandParameter, ElementName=Root}"
            Content="{markup:Tr Projects.BringToFront}"
            Focusable="{Binding ButtonFocusable, ElementName=Root}"
            Icon="{ui:SymbolIcon ArrowMaximize24}"
            Style="{Binding ButtonStyle, ElementName=Root}"
            Visibility="{Binding IsUnityRunning, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </Grid>
</UserControl>
